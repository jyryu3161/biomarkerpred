        "object",
        "null"
      ],
      "default": null,
      "properties": {
        "gene_file": {
          "type": "string"
        },
        "score_threshold": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string"
        },
        "disease_name": {
          "type": "string"
        },
        "efo_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
