      ],
      "additionalProperties": true
    },
    "binary": {
      "$ref": "#/$defs/analysis"
    },
    "survival": {
      "$ref": "#/$defs/analysis"
    },
    "workdir": {
      "type": "string"
    },
    "type": {
      "enum": [
        "binary",
        "survival"
      ]
    },
    "num_seed": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy migration input only; does not control nested validation."
    },
    "freq": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy count converted to freq/num_seed."
    }
  },
  "additionalProperties": true,
  "description": "Supply flat analysis fields or a binary/survival section. Paths relative to explicit workdir, otherwise the config file directory. Unknown extension options are preserved and surfaced in normalization warnings."
}
